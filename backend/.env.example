# 应用
APP_NAME=jd-resume-platform
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# 数据库（async，运行时使用）
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/jd_platform
# 数据库（sync，Alembic 迁移使用）
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@postgres:5432/jd_platform

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 安全
SECRET_KEY=change-me-in-production-32bytes-minimum
FERNET_KEY=

# 文件存储（Docker 内固定路径）
RESUME_STORAGE_DIR=/app/data/resumes

# 限流
RATE_LIMIT_CRAWLER_QPS=2
RATE_LIMIT_LLM_QPS=5

# 爬虫
CRAWLER_TIMEOUT_SEC=30
CRAWLER_USER_AGENT_POOL_SIZE=50

# LLM
LLM_DEFAULT_PROVIDER=openai
EMBEDDING_DIM=1024

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
