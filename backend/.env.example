# 应用
APP_NAME=jd-resume-platform
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# 数据库（本地 SQLite）
DATABASE_URL=sqlite+aiosqlite:///./data/jd_platform.db
DATABASE_SYNC_URL=sqlite:///./data/jd_platform.db

# 安全
SECRET_KEY=change-me-in-production-32bytes-minimum
FERNET_KEY=

# 文件存储
RESUME_STORAGE_DIR=./data/resumes

# 爬虫
CRAWLER_ENABLED=true
CRAWLER_TIMEOUT_SEC=30
CRAWLER_USER_AGENT_POOL_SIZE=50

# LLM
LLM_DEFAULT_PROVIDER=mock
EMBEDDING_DIM=1024

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
